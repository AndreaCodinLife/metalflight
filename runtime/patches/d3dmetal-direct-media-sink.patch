         void **obj)
 {
@@ -688,6 +840,25 @@ static HRESULT WINAPI video_frame_sink_stream_get_service_GetService(IMFGetServi
     {
         if (sink->device_manager)
             return IUnknown_QueryInterface(sink->device_manager, riid, obj);
+        /* MSFS24 D3DMetal direct path (system-memory frames): offer a recycling system-memory sample allocator,
+         * so the session does not allocate and free a whole 4K frame buffer for every decoded frame. */
+        if (IsEqualIID(riid, &IID_IMFVideoSampleAllocator))
+        {
+            char setting[2];
+            HRESULT hr;
+            if (GetEnvironmentVariableA("MSFS24_WINE_MEDIA_D3DMETAL_DIRECT", setting, sizeof(setting)) != 1 || setting[0] != '1')
+                return E_NOINTERFACE;
+            EnterCriticalSection(&sink->cs);
+            if (!sink->sysmem_allocator && FAILED(hr = create_sysmem_allocator(&sink->sysmem_allocator)))
+            {
+                LeaveCriticalSection(&sink->cs);
+                ERR("MSFS24 D3DMetal direct frames: system-memory allocator failed, hr %#lx\n", hr);
+                return hr;
+            }
+            LeaveCriticalSection(&sink->cs);
+            ERR("MSFS24 D3DMetal direct frames: system-memory sample allocator\n");
+            return IMFVideoSampleAllocator_QueryInterface(sink->sysmem_allocator, riid, obj);
+        }
         return E_NOINTERFACE;
     }
 
