+static ULONG_PTR platform_stack_preflight_window(void)
+{
+    static ULONG_PTR window;
+
+    if (!window)
+    {
+        const char *env = getenv( "MSFS24_WINE_STACK_PREFLIGHT_WINDOW" );
+        ULONG_PTR value = env ? strtoul( env, NULL, 0 ) : 0x40000;
+
+        if (value < 0x4000) value = 0x4000;
+        if (value > 0x400000) value = 0x400000;
+        window = (value + host_page_mask) & ~host_page_mask;
+    }
+    return window;
+}
+
+static BOOL platform_stack_open_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "MSFS24_WINE_STACK_OPEN" );
+        enabled = env && !strcmp( env, "1" );
+    }
+    return enabled;
+}
