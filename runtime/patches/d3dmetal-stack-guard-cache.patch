+    unsigned int n = __atomic_add_fetch( &misses, 1, __ATOMIC_RELAXED );
+    thread_data->platform_stack_cache_misses++;
+    if ((n == 100 || !(n & 0x3fff)) && __atomic_add_fetch( &logs, 1, __ATOMIC_RELAXED ) <= 256)
+        WARN_(msfs_platform)( "stack guard cache: misses=%u tid=%04x thread_hits=%u thread_misses=%u cached=%u generation=%u\n",
+                              n, GetCurrentThreadId(), thread_data->platform_stack_cache_hits,
+                              thread_data->platform_stack_cache_misses, cached,
+                              __atomic_load_n( &platform_vprot_generation, __ATOMIC_RELAXED ) );
+}
